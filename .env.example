# Copy to .env for local overrides; the flask CLI loads it automatically.
# Every setting is optional in development. See the README's configuration table.

# Defaults to SQLite at instance/dev.sqlite3. To run on a local Postgres instead:
# DATABASE_URL=postgresql+psycopg://user@localhost:5432/scryapi

# Raise these if you are hammering the API locally (e.g. running scripts/smoke.py in a loop).
# SCRYAPI_RATELIMIT_SEARCH=60/minute
# SCRYAPI_RATELIMIT_AUTH=10/minute

# Frontend on another origin, e.g. a Vite dev server. Leave unset if the frontend is
# served from the API's host.
# SCRYAPI_CORS_ORIGINS=http://localhost:5173
